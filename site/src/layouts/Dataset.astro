---
// A page of the dataset section: the section's own navigation over the page.
import Base from './Base.astro';
import { DATASET_PAGES } from '../lib/dataset-nav';

interface Props {
  title: string;
  description: string;
  slug: string;
}
const { title, description, slug } = Astro.props;
---

<Base title={title === 'The dataset' ? title : `${title} · The dataset`} section="The dataset" description={description}>
  <div class="frame dataset">
    <nav class="dsnav" aria-label="The dataset">
      <a class="dsnav-home" href="/dataset/">The dataset</a>
      <ul>
        {
          DATASET_PAGES.map((p) => (
            <li>
              <a href={`/dataset/${p.slug ? `${p.slug}/` : ''}`} aria-current={p.slug === slug ? 'page' : undefined}>
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <slot />
  </div>
</Base>

<style>
  .dataset {
    display: grid;
    gap: var(--space-6);
  }
  .dataset > :global(*) {
    min-width: 0;
  }
  .dsnav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    font-size: var(--step--1);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--space-3);
  }
  .dsnav-home {
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .dsnav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    min-width: 0;
    flex: 1 1 auto;
  }
  .dsnav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 2px solid transparent;
  }
  .dsnav a:hover {
    color: var(--ink);
  }
  .dsnav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  @media (max-width: 40rem) {
    .dsnav ul {
      flex: 1 1 100%;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      max-width: 100%;
      padding-bottom: var(--space-1);
    }
    .dsnav ul::-webkit-scrollbar {
      display: none;
    }
    .dsnav li {
      flex: none;
    }
  }
</style>
