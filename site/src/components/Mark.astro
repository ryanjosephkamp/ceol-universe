---
// The family's mark: the universe as an outlined square, and the English
// OpenList as the filled square inside its corner, the subset it is.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="1.5" y="1.5" width="21" height="21" fill="none" stroke="var(--accent)" stroke-width="2.25"></rect>
  <rect x="5" y="12" width="7" height="7" fill="var(--eol)"></rect>
</svg>

<style>
  .mark {
    flex: none;
    display: block;
  }
</style>
