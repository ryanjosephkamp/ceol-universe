---
import Base from '../layouts/Base.astro';
---

<Base
  title="Not found"
  section="Not found"
  description="This page does not exist on the Common English OpenList. Start from the home page or one of the sections."
>
  <div class="frame about">
    <header class="page-head">
      <h1>Not found</h1>
      <p class="lede">
        There is no page at this address. It may have moved, or the address may be mistyped.
      </p>
    </header>
    <p>Go to the <a href="/">start page</a>, or choose a section from the menu.</p>
  </div>
</Base>
